{
  "name": "dsh-subagent-kimi",
  "version": "0.1.3",
  "description": "One-shot Kimi Code CLI subagent provider for DeepSeek Harness over ACP",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "kimi",
    "kimi-code",
    "subagent",
    "acp",
    "cordis"
  ],
  "license": "MIT",
  "author": "Saviio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Saviio/dsh-subagent-kimi.git"
  },
  "homepage": "https://github.com/Saviio/dsh-subagent-kimi#readme",
  "bugs": {
    "url": "https://github.com/Saviio/dsh-subagent-kimi/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "icon.png",
    "NOTICE",
    "locale/*.json",
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=24.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "icon": "./icon.png",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run clean && npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-subagent": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-subprocess": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-timeout": ">=0.2.1-rc.2 <0.3.0"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@deepseek-ai/dsh-brand": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-tool-subagent": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.6",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-app-boot": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-loader-smoke": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-checkpoint-policy": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.3",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.3",
    "@deepseek-ai/dsh-subprocess-local": "0.2.1-rc.3",
    "@deepseek-ai/dsh-timeout": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tool-jobs": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@moonshot-ai/kimi-code": "2.3.1",
    "@types/node": "^24.10.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "@deepseek-ai/dsh-subprocess-local@0.2.1-rc.3": true,
    "node-pty@1.1.0": true,
    "node-pty@1.2.0-beta.15": true,
    "koffi@3.1.1": true,
    "esbuild@0.28.2": true,
    "@moonshot-ai/kimi-code": false
  }
}
